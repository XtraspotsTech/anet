# Copy to .env and fill in. Never commit .env.
# Sandbox and production are entirely separate systems: separate URLs,
# separate credentials, separate logins. Sandbox keys will never work
# against production.

# sandbox | production
ANET_ENV=sandbox

# Account, then API Credentials & Keys, in the merchant interface.
ANET_API_LOGIN_ID=
ANET_TRANSACTION_KEY=

# Accept.js only. Generate on the same page as the Transaction Key.
# This one is public and is meant to reach the browser. The Transaction
# Key above is not, and must never be sent client-side.
ANET_PUBLIC_CLIENT_KEY=
